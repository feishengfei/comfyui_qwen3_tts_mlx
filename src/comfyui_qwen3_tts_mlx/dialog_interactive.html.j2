<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
/* ========== 全局基础变量：浅色模式默认 ========== */
:root {
    --bg-page: #ffffff;
    --text-main: #111111;
    --text-secondary: #444444;
    --border-color: #cccccc;
    --header-bg: #f7f7f7;
}
/* ========== 深色模式变量 class=theme-dark ========== */
.theme-dark {
    --bg-page: #020617;
    --text-main: #c7d1dd;
    --text-secondary: #94a3b8;
    --border-color: #475569;
    --header-bg: #0f172a;
}
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    background-color: var(--bg-page);
    color: var(--text-main);
    padding: 24px 16px;
    transition: background-color 0.3s, color 0.3s;
    font-size: 27px;
}
/* 右上角主题切换按钮 */
.theme-toggle-wrap {
    position: fixed;
    top:12px;
    right:16px;
    z-index:999;
}
#btn-theme-switch {
    padding:6px 12px;
    border-radius:6px;
    border:1px solid var(--border-color);
    background:var(--header-bg);
    color:var(--text-main);
    cursor:pointer;
    font-size:14px;
}
.quiz-meta {
    text-align: center;
    margin-bottom: 28px;
    padding-top:30px;
}
.quiz-meta h1 {
    font-size: 28px;
    margin-bottom: 8px;
}
.quiz-meta .subject-desc {
    font-size:1rem;
    color:var(--text-secondary);
}
.group-block {
    margin-bottom: 32px;
}
.group-title {
    font‑size: 20px;
    font-weight: bold;
    margin-top: 24px;
    margin-bottom:12px;
    padding-bottom:4px;
    border-bottom: 1px solid var(--border-color);
}
.audio-wrap {
    margin:8px 0 16px 0;
}
audio {
    width:100%;
}
/* 对话气泡样式 */
.bubble {
    width:100%;
    border-radius:10px;
    padding:14px;
    margin-bottom:12px;
    display: flex;
    gap:12px;
    page-break-inside: avoid;
}
.avatar-box {
    flex-shrink:0;
    width:64px;
    text-align:center;
}
.avatar-img {
    width:64px;
    height:64px;
    object-fit:cover;
    border-radius:6px;
}
.avatar-placeholder {
    width:64px;
    height:64px;
    border-radius:6px;
    border:1px solid var(--border-color);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    text-align:center;
    color:var(--text-secondary);
}
.avatar-name-text {
    font-size:11px;
    margin-top:4px;
    color:var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.bubble-text {
    flex-grow:1;
}
.bubble-text p {
    margin-bottom:8px;
    line-height:1.7;
}
.bubble-text p:last-child {
    margin-bottom:0;
}
</style>
</head>
<body>
<div class="theme-toggle-wrap">
    <button id="btn-theme-switch">切换深色模式</button>
</div>

<div class="quiz-meta">
    <h1>{{ quiz_meta.title | e }}</h1>
    {% if quiz_meta.subject %}
    <div class="subject-desc">{{ quiz_meta.subject | e }}</div>
    {% endif %}
</div>

{% for g in groups %}
<div class="group-block">
    <div class="group-title">{{ g.gt | e }}</div>
    {% if g.group_audio_b64 %}
    <div class="audio-wrap">
        <audio controls data-group-idx="{{ loop.index0 }}" src="{{ g.group_audio_b64 }}">
    </div>
    {% endif %}

    {% for bubble in g.bubbles %}
    <div class="bubble" style="background-color: {{ bubble.bubble_bg }};">
        <div class="avatar-box">
        {% if bubble.avatar_b64 %}
            <img class="avatar-img" src="{{ bubble.avatar_b64 }}" alt="{{ bubble.sp | e }}">
        {% else %}
            <div class="avatar-placeholder">{{ bubble.sp | e }}</div>
        {% endif %}
        {% if bubble.full_name %}
        <div class="avatar-name-text"><b>{{ bubble.full_name | e }}</b></div>
        {% endif %}
        </div>
        <div class="bubble-text">
            {% for para in bubble.txt_list %}
            <p><b>{{ para | e }}</b></p>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>
{% endfor %}

<script>
// 主题切换逻辑
const btnSwitch = document.getElementById("btn-theme-switch");
const bodyEl = document.body;
let isDark = false;
btnSwitch.addEventListener("click", ()=>{
    isDark = !isDark;
    if(isDark){
        bodyEl.classList.add("theme-dark");
        btnSwitch.textContent = "切换浅色模式";
    }else{
        bodyEl.classList.remove("theme-dark");
        btnSwitch.textContent = "切换深色模式";
    }
});

// audio互斥：播放一个，暂停其余所有audio标签
const audioList = Array.from(document.querySelectorAll("audio"));
audioList.forEach(audio=>{
    audio.addEventListener("play", function(){
        audioList.forEach(otherAu=>{
            if(otherAu !== this){
                otherAu.pause();
            }
        })
    })
});
</script>
</body>
</html>
