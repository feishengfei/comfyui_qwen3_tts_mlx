<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device‑width, initial‑scale=1.0">
<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    font-size: 38px;
    line-height: 1.6;
    background: #ffffff;
    color: #111111;
    padding: 16px 14px;
    max-width: 100%;
}
.quiz-meta {
    text-align: center;
    margin-bottom: 18px;
}
.quiz-meta h1 {
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 6px;
}
.quiz-meta .subject-desc {
    font-size: 20px;
    color: #444444;
}
.group-block {
    margin-bottom: 18px;
}
.group-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid #aaaaaa;
}
/* 对话气泡，适配1080*1920截图视口 */
.bubble {
    width: 100%;
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 8px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    page-break-inside: avoid;
}
.avatar-box {
    flex-shrink: 0;
    width: 90px;
    text-align:center;
}
.avatar-img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
    margin:0 auto;
}
.avatar-placeholder {
    width: 60px;
    height: 60px;
    border: 1px solid #aaa;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    text-align: center;
    color: #444;
    margin:0 auto;
}
.avatar-name-text {
    font-size:14px;
    margin-top:2px;
    color:#444444;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.bubble-text {
    flex-grow: 1;
}
.bubble-text p {
    margin-bottom: 6px;
}
.bubble-text p:last-child {
    margin-bottom: 0;
}
</style>
</head>
<body>
<div class="quiz-meta">
    <h1>{{ quiz_meta.title | e }}</h1>
    {% if quiz_meta.subject %}
    <div class="subject‑desc">{{ quiz_meta.subject | e }}</div>
    {% endif %}
</div>

{% for g in groups %}
<div class="group-block">
    <div class="group-title">{{ g.gt | e }}</div>
    {% for bubble in g.bubbles %}
    <div class="bubble" style="background-color: {{ bubble.bubble_bg }};">
        <div class="avatar-box">
        {% if bubble.avatar_b64 %}
            <img class="avatar-img" src="{{ bubble.avatar_b64 }}" alt="{{ bubble.sp | e }}">
        {% else %}
            <div class="avatar-placeholder">{{ bubble.sp | e }}</div>
        {% endif %}
        {% if bubble.full_name %}
        <div class="avatar-name-text"><b>{{ bubble.full_name | e }}</b></div>
        {% endif %}
        </div>
        <div class="bubble-text">
            {% for para in bubble.txt_list %}
            <p><b>{{ para | e }}</b></p>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>
{% endfor %}
</body>
</html>
